        { "nom": "largeur", "label": "Largeur", "type": "int", "min": 1, "max": 512, "pas": 1, "defaut": 5,
          "aide": "Diamètre des disques (points) ou épaisseur de l'anneau, en pixels du spectre." },
        { "nom": "u", "label": "u (mode points)", "type": "int", "min": -2048, "max": 2048, "pas": 1, "defaut": 16,
          "aide": "Position du pic sur le spectre recentré (traitement FFT) : u = x - largeur/2, v = y - hauteur/2." },
        { "nom": "v", "label": "v (mode points)", "type": "int", "min": -2048, "max": 2048, "pas": 1, "defaut": 0 },
        { "nom": "rayon", "label": "Rayon (mode anneau)", "type": "int", "min": 0, "max": 2048, "pas": 1, "defaut": 30 }
      ]
    },
    {
      "id": "rehaussement-spectral",
      "nom": "Rehaussement de contraste spectral",
      "chapitre": "Filtrage spectral",
      "description": "Image + k × image filtrée passe-haut, calculé dans le domaine spectral : G = F · (1 + k · H_passe-haut). Accentue les détails en gardant les zones uniformes.",
      "auteur": "Evrad",
      "langage": "Rust",
      "commande": ["rust/target/release/traitements", "rehaussement-spectral"],
      "entrees": [{ "nom": "Image", "type": "gris" }],
      "sortie": "image",
      "params": [
        { "nom": "forme", "label": "Forme du passe-haut", "type": "choix", "options": ["ideal", "butterworth", "gaussien"], "defaut": "gaussien" },
        { "nom": "coupure", "label": "Fréquence de coupure D0", "type": "int", "min": 1, "max": 2048, "pas": 1, "defaut": 30 },
        { "nom": "ordre", "label": "Ordre (Butterworth)", "type": "int", "min": 1, "max": 10, "pas": 1, "defaut": 2 },
        { "nom": "k", "label": "Coefficient k", "type": "float", "min": 0, "max": 5, "pas": 0.1, "defaut": 1.0 }
