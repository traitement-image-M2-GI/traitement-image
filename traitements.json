    },
    {
      "id": "egalisation",
      "nom": "Égalisation d'histogramme",
      "chapitre": "Amélioration du contraste",
      "description": "Aplanit l'histogramme pour utiliser toute la plage 0-255. Globale : un histogramme pour toute l'image. Locale : histogramme de la fenêtre autour de chaque pixel.",
