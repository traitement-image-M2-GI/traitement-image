# Fins de ligne : tous les fichiers texte sont stockés et extraits en LF (Linux, macOS et Windows).
# Évite les différences parasites entre membres du groupe.
* text=auto eol=lf

# Images et archives : binaires, jamais modifiées par Git (sinon elles sont corrompues sous Windows).
*.pgm  binary
*.ppm  binary
*.pbm  binary
*.pnm  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.tif  binary
*.tiff binary
*.webp binary
*.zip  binary
*.pdf  binary

# Scripts propres à Windows : fins de ligne Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
